  "private": true,
  "scripts": {
    "predev": "tsx scripts/fonts.mts",
    "dev": "next dev",
    "prebuild": "tsx scripts/fonts.mts",
    "build": "next build",
    "vercel-build": "npm run fonts && npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "tsx scripts/reset.mts && npm run db:migrate && npm run db:seed",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:staff-passwords": "tsx scripts/staff-passwords.mts",
    "momo:mtn-sandbox": "tsx scripts/mtn-sandbox.mts",
    "fonts": "tsx scripts/fonts.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@vercel/blob": "^2.8.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
